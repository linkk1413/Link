rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Category images - admins can upload, everyone can read
    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 2 * 1024 * 1024  // Max 2MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Home/provider banner slides - admins manage them via the admin panel,
    // everyone can read. Same trust level as categories/ (the real gate is
    // firestore.rules blocking settings/* writes to non-admins).
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 2 * 1024 * 1024  // Max 2MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Service images - providers can upload, everyone can read
    match /services/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024  // Max 5MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Account avatars (client and provider profile pictures)
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024  // Max 2MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Provider profile photos
    match /providers/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Identity verification documents — only the owning provider can upload;
    // admins review via the download URL stored in the verifications doc.
    match /verifications/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }

    // Report attachments — only the reporter can upload to their own folder;
    // any signed-in user may read (the URL is only reachable via a report
    // doc, which firestore.rules already limits to the reporter or admin).
    match /reports/{reporterId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == reporterId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}

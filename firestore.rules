rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      // Check activeRole first for role switching support, fallback to legacy role field
      let userData = userDoc().data;
      return signedIn() ? (userData.activeRole != null ? userData.activeRole : userData.role) : null;
    }

    function bookingDoc(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId));
    }

    function serviceDoc(serviceId) {
      return get(/databases/$(database)/documents/services/$(serviceId));
    }

    function hasUserDoc() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return role() == "ADMIN";
    }

    function isProvider() {
      return role() == "PROVIDER";
    }

    function isClient() {
      return role() == "CLIENT";
    }

    // A user editing their own doc can never grant themselves ADMIN. Only an
    // existing admin (via the isAdmin() branch on the rule itself) may do that.
    function noSelfAdminEscalation() {
      let d = request.resource.data;
      return !('ADMIN' in d.get('roles', []))
        && d.get('activeRole', '') != 'ADMIN'
        && d.get('role', '') != 'ADMIN';
    }

    match /users/{userId} {
      // Allow get for own document or admin
      allow get: if signedIn() && (userId == request.auth.uid || isAdmin());
      // Admins get the full list (needed by the admin users panel). Everyone
      // else is capped to limit(1) — enough for the phone-uniqueness check,
      // not enough to dump the collection.
      allow list: if isAdmin() || (signedIn() && request.query.limit <= 1);
      allow create: if signedIn() && userId == request.auth.uid && noSelfAdminEscalation();
      allow update: if isAdmin() || (
        signedIn() && userId == request.auth.uid && noSelfAdminEscalation()
      );
      allow delete: if isAdmin();
    }

    match /providers/{providerId} {
      allow read: if true;
      allow create: if signedIn() && (providerId == request.auth.uid || isAdmin());
      // Owner/admin may update their profile, but ratingAvg/ratingCount and
      // the isVerified/verifiedAt "Trusted Provider" badge are computed
      // server-side (see functions/onReviewWritten) from real reviews —
      // not even the owner may write them directly.
      allow update: if isAdmin() || (
        signedIn() && providerId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['ratingAvg', 'ratingCount', 'isVerified', 'verifiedAt']
        )
      );
      allow delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      // Allow create if authenticated and providerId matches the user's uid
      // (Provider role check via profile is done in the app layer)
      allow create: if signedIn() && request.resource.data.providerId == request.auth.uid;
      allow update, delete: if signedIn() && (isAdmin() || resource.data.providerId == request.auth.uid);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if signedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if signedIn()
        && request.resource.data.clientId == request.auth.uid
        && (isClient() || !hasUserDoc())
        && request.resource.data.serviceId != null
        && serviceDoc(request.resource.data.serviceId).data.providerId == request.resource.data.providerId
        && request.resource.data.priceTotal == serviceDoc(request.resource.data.serviceId).data.price;
      allow update: if signedIn() && (
        (isClient() && resource.data.clientId == request.auth.uid) ||
        (isProvider() && resource.data.providerId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if signedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if signedIn()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.bookingId != null
        && bookingDoc(request.resource.data.bookingId).data.clientId == request.auth.uid
        && bookingDoc(request.resource.data.bookingId).data.providerId == request.resource.data.providerId
        && request.resource.data.amountSar == bookingDoc(request.resource.data.bookingId).data.priceTotal;
      // status/captureId are written server-side (with the Moyasar secret key,
      // after the real capture/void/refund call succeeds) via the Admin SDK,
      // which bypasses these rules entirely — so clients never need direct
      // write access here. Letting the provider write it themselves would let
      // them fake a "CAPTURED" status without any money ever moving.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if signedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if signedIn() && (
        request.resource.data.clientId == request.auth.uid ||
        request.resource.data.providerId == request.auth.uid
      );
      allow update: if signedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read, create: if signedIn() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.providerId == request.auth.uid ||
          isAdmin()
        );
        allow update, delete: if isAdmin();
      }
    }

    match /payouts/{payoutId} {
      allow read: if signedIn() && (
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if signedIn() && isProvider() && request.resource.data.providerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // Only clients may create reviews, and only under their own identity.
      allow create: if signedIn() && isClient() && request.resource.data.clientId == request.auth.uid;
      // Allow providers to add reply to reviews about them, and admins to update anything
      allow update: if isAdmin() || (
        signedIn() && isProvider() &&
        resource.data.providerId == request.auth.uid &&
        // Only allow adding reply fields, not modifying rating/comment
        request.resource.data.rating == resource.data.rating &&
        request.resource.data.comment == resource.data.comment &&
        request.resource.data.clientId == resource.data.clientId &&
        request.resource.data.providerId == resource.data.providerId
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.clientId == request.auth.uid);
    }

    match /reports/{reportId} {
      allow read: if signedIn() && (
        resource.data.reporterId == request.auth.uid ||
        isAdmin()
      );
      allow create: if signedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /blockedUsers/{blockId} {
      allow read: if signedIn() && (
        resource.data.blockerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if signedIn() && request.resource.data.blockerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.blockerId == request.auth.uid;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /verifications/{verificationId} {
      allow read: if signedIn() && (
        resource.data.providerId == request.auth.uid || isAdmin()
      );
      allow create: if signedIn() && isProvider()
        && request.resource.data.providerId == request.auth.uid
        && request.resource.data.status == "PENDING";
      // Only admin decides approve/reject.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
